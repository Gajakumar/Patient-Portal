# Patient Portal (Katalon) - required environment variables.
# Copy this file to .env (project root) for LOCAL runs and fill in real values there.
# On CI / Grok Bot cloud runners, set these as environment variables instead - never copy .env.
# Placeholders only. NEVER put real credentials in this file.
# Lookup order used by Keywords/com/portal/config/EnvConfig.groovy: OS env -> -D system property -> .env

# --- MaximEyes (provider app) login -> GlobalVariable.MaxUsername / MaxPassword
MAXIMEYES_USERNAME=your-maximeyes-username
MAXIMEYES_PASSWORD=change-me
# MaximEyes e-signature password (encounter sign-off / SOC upload scripts)
MAXIMEYES_SIGNATURE_PASSWORD=change-me
# MaximEyes qa8 login password used by Scripts/common/Maximeyes/UserLogin and Demo_Maximeyes/PtPhotoUpload
MAXIMEYES_QA8_PASSWORD=change-me
# MaximEyes "authority password" used when creating provider users (Scripts/New Test Case)
MAXIMEYES_AUTHORITY_PASSWORD=change-me

# --- Gmail mailbox used for OTP / email verification -> GlobalVariable.MyEmail_Id / Email_Key
GMAIL_ADDRESS=your-test-mailbox@example.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# --- Patient Portal account passwords -> GlobalVariable.UpdatePassword / changedPassword / RestUpdatedPass
PP_UPDATE_PASSWORD=change-me
PP_CHANGED_PASSWORD=change-me
PP_REST_UPDATED_PASSWORD=change-me

# --- Patient Portal API -> GlobalVariable.apiUsername, PP_API_AUTH_TOKEN, PP_API_SESSION_GUID
PP_API_USERNAME=your-api-username
PP_API_AUTH_TOKEN=your-bearer-token-without-the-Bearer-prefix
PP_API_SESSION_GUID=00000000-0000-0000-0000-000000000000

# --- QA database -> GlobalVariable.DB_USERNAME / DB_PASSWORD / DB_PASSWORD1
DB_USERNAME=your-db-username
DB_PASSWORD=change-me
DB_PASSWORD_ALT=change-me

# --- SMTP account used by Test Listeners/EmailListener.groovy to mail suite reports
SMTP_USERNAME=reports-sender@example.com
SMTP_PASSWORD=change-me

# --- Katalon TestOps OAuth2 client used by Include/scripts/groovy/com/katalon/KatalonHelper.groovy
KATALON_OAUTH2_CLIENT_ID=your-client-id
KATALON_OAUTH2_CLIENT_SECRET=your-client-secret